✅ Step 2: Update ALL Manifest Files to Use This Namespace
# Run this command to add namespace to all YAML files:
for file in kubernetes-manifests/*.yaml; do
  echo "✏️ Adding namespace to $file"
  # Add namespace under metadata if not already present
  if ! grep -q "namespace:" "$file"; then
    sed -i '/^metadata:/a\  namespace: Micro-app' "$file"
  fi
done
